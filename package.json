{
  "name": "mmr-groups",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter @mmr/web dev",
    "build": "pnpm --filter @mmr/web build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "scenarios:check": "node scripts/check-scenarios.ts",
    "scenarios:attribution": "node scripts/scenarios-attribution.ts",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @mmr/api db:generate",
    "db:migrate:local": "pnpm --filter @mmr/web exec wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "pnpm --filter @mmr/web exec wrangler d1 migrations apply DB --remote && pnpm --filter @mmr/web exec wrangler d1 migrations apply DB --remote --env preview",
    "db:seed:demo": "node scripts/seed-demo.ts",
    "e2e": "pnpm --filter @mmr/e2e test",
    "mutate:changed": "node scripts/mutate-changed.ts",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "~1.4.7",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "~4.1.12"
  }
}
