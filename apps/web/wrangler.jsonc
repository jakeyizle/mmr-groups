{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mmr-groups",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "not_found_handling": "single-page-application",
    // Without this, navigating directly to /api/* would get index.html.
    "run_worker_first": ["/api/*"],
  },
  // Workers Logs: keeps the API's JSON request lines (PLAN §12), queryable by field.
  "observability": { "enabled": true },
  // Top level = production.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mmr-groups",
      "database_id": "14ec1da9-a1d0-4c3f-b31e-59de2dbdc40c",
      "migrations_dir": "../../packages/api/migrations",
    },
  ],
  "env": {
    "preview": {
      // PR builds upload versions with --preview-alias pr-<n>.
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mmr-groups-preview",
          "database_id": "ef8ece56-a62f-408b-8fa0-b9c1fc8d8851",
          "migrations_dir": "../../packages/api/migrations",
        },
      ],
    },
  },
}
